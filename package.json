{
  "name": "warehouse-quality-integration",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply warehouse-quality-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply warehouse-quality-db --remote",
    "typecheck": "tsc --noEmit",
